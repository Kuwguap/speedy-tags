{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tristatetag.com" }],
      "destination": "https://tristatetags.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tristatetag.com" }],
      "destination": "https://tristatetags.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tristatetags.com" }],
      "destination": "https://tristatetags.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/backend/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/backend/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/api/interview/:path*",
        "destination": "/api/interview-proxy?path=:path*"
      }
    ],
    "afterFiles": [
      { "source": "/sitemap.xml", "destination": "/api/sitemap" },
      { "source": "/robots.txt", "destination": "/api/robots" },
      { "source": "/backend", "destination": "/backend/index.html" },
      { "source": "/backend/", "destination": "/backend/index.html" }
    ],
    "fallback": [
      { "source": "/(.*)", "destination": "/index.html" }
    ]
  }
}
