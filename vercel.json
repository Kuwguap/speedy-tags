{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tristatetag.com" }],
      "destination": "https://tristatetags.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tristatetag.com" }],
      "destination": "https://tristatetags.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tristatetags.com" }],
      "destination": "https://tristatetags.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/backend/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/backend/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/backend", "destination": "/backend/index.html" },
    { "source": "/backend/", "destination": "/backend/index.html" },
    {
      "source": "/api/tag/:path*",
      "destination": "/api/tag-proxy?path=:path*"
    },
    {
      "source": "/api/interview/:path*",
      "destination": "/api/interview-proxy?path=:path*"
    },
    {
      "source": "/api/dispatch/:path*",
      "destination": "/api/dispatch-proxy?path=:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/backend-proxy?path=:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
