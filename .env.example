# Admin dashboard password (required for /admin access)
ADMIN_PASSWORD=your-secure-password

# JWT secret for admin session (change in production)
JWT_SECRET=change-this-to-a-random-secret-in-production

# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_IDS=-1001234567890,123456789
# Dispatcher mode (optional): dispatcherId:groupId:groupName – fallback if none in admin settings
# e.g. -123456789:-1001234567890:Bronx Dispatch
TELEGRAM_DISPATCHERS=
# Source shown in Telegram notifications (e.g. tristatetags)
BOLDY_SOURCE=tristatetags

# Secret sharing for dispatcher phone links (ClientPhoneNumber; same ONETIMESECRET_* names for compatibility)
ONETIMESECRET_USERNAME=
ONETIMESECRET_API_KEY=
ONETIMESECRET_URL=https://clientsphonenumber.com/api/v1/share
ONETIMESECRET_LINK_BASE=https://clientsphonenumber.com/secret/
# Passphrase for share API body and for AES /secure/phone encryption (inform dispatchers of the same value)
ONETIMESECRET_PASSPHRASE=Callclient

# Fallback: if nobody accepts within 45s, auto-assign (put in Render)
FALLBACK_DISPATCHER_ID=-1003741637507
FALLBACK_GROUP_ID=-1003741637507
FALLBACK_GROUP_NAME=Tatiana's Team
FALLBACK_CLAIM_TIMEOUT_MS=300000
API_PUBLIC_URL=https://your-render-api.onrender.com

# Supabase (optional - uses file storage when not set)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (required for AI auto-fill on the Tag Information page)
# Powers the document/text parser that pre-fills the post-payment form.
OPENAI_API_KEY=sk-xxxxx
# Optional: override the model. Default is gpt-4o-mini (cheap + supports vision).
OPENAI_MODEL=gpt-4o-mini

# Stripe (required for checkout)
STRIPE_SECRET_KEY=sk_live_xxxxx
# Primary app URL for redirects - use one of your domains (comma-separated = first is used)
# Sites: tristatetag.com, tristatetags.com, speedytags.vercel.app
# Comma-separated = both domains for correct redirects (tristatetag.com, tristatetags.com)
APP_URL=https://tristatetag.com,https://tristatetags.com

# Resend (for success emails when delivery = email AND new-lead notifications)
# Get key at https://resend.com - free tier: 100 emails/day
RESEND_API_KEY=re_xxxxx
# Customer-facing From (success emails). Use a verified domain, e.g. TriState Tags <orders@tristatetag.com>
FROM_EMAIL=TriState Tags <onboarding@resend.dev>
# Internal From for new-lead notifications. Falls back to FROM_EMAIL if unset.
# Must be a verified sender on Resend.
RESEND_FROM_EMAIL=TriState Tags Leads <leads@tristatetag.com>
# Comma-separated recipients who receive every new lead. Leave unset to use the
# built-in defaults (Farwac434@gmail.com, Sensi.ads@outlook.com, SendReceiptToday@gmail.com).
LEAD_NOTIFICATION_EMAILS=
# Comma-separated personal Telegram chat IDs (NOT group IDs) that also receive
# every new lead as a plain DM from the bot. Each recipient must /start the bot
# at least once or DMs silently fail. Leave unset to use the built-in defaults
# (1184788227, 1203347742, 5994570412).
LEAD_NOTIFICATION_TELEGRAM_IDS=
