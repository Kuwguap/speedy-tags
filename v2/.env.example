# --- TriStateTags v2 env ---
# Copy to .env (or .env.local) and fill the values.

# Server port (default 3001). The Vite dev server proxies /api to this.
PORT=3001

# Admin login password for /admin
ADMIN_PASSWORD=change-me-please

# Public app URL (used for Paystack callback URL)
APP_URL=http://localhost:5173

# --- Paystack ---
# https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Currency code Paystack will charge in. Site shows "$" but Paystack must be
# in a currency your account is approved for. Use USD only on USD-enabled accounts.
PAYSTACK_CURRENCY=USD

# --- Optional: email receipts via Resend (https://resend.com) ---
# If unset, the order is still saved but no email is sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=TriStateTags <orders@your-domain.com>
