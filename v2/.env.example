# --- Kingsman Tags env ---
# Copy to .env and fill the values.

# Server port (default 3001). The Vite dev server proxies /api to this.
PORT=3001

# Admin login password for /admin
ADMIN_PASSWORD=change-me-please

# Public app URL — used for callback and account links in emails.
APP_URL=http://localhost:5173

# --- Payment processor ---
# https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Currency the payment processor will actually charge in. The site always
# displays "$" to the customer regardless of this setting.
PAYSTACK_CURRENCY=USD

# Flat price for the temporary tag (major units, e.g. dollars).
TAG_PRICE=150

# Extra charge when the customer opts in to our 1-month insurance coverage.
INSURANCE_OPT_IN_PRICE=100

# Set to 1 to expose POST /api/test/simulate-purchase used by /qwertyuiop.
# Automatically enabled while ADMIN_PASSWORD is still the default.
ENABLE_TEST_MODE=1

# --- Renewal schedule ---
# Number of days after a paid order to send a renewal reminder.
RENEWAL_PERIOD_DAYS=28
# How often the renewal sweep runs, in minutes. Keep at 60 in production.
RENEWAL_CHECK_INTERVAL_MINUTES=60

# --- Email delivery (optional but recommended) ---
# https://resend.com  — required to send welcome + renewal emails.
RESEND_API_KEY=
# Internal-only — never shown in the UI.
RESEND_FROM=
